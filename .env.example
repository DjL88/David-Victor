# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform API key for address search, geocoding, and reverse geocoding
GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for address search, geocoding, and distance calculations
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_MAP_ID: Optional Map ID for Advanced Markers (falls back to DEMO_MAP_ID in development only)
VITE_GOOGLE_MAPS_MAP_ID=""

# DELIVERECT PARTNER OAUTH CREDENTIALS (Held server-side by the BFF - NEVER exposed to browser)
# Obtain from Deliverect Developer Portal for your partner application:
DELIVERECT_CLIENT_ID=""
DELIVERECT_CLIENT_SECRET=""
DELIVERECT_ENV="staging" # staging | production

# PLATFORM_SUPERADMIN_EMAILS: Comma-separated allowlist of initial administrator email addresses for first-admin bootstrap.
# After verifyIdToken() cryptographically succeeds, if the verified Firebase email appears in this allowlist, the session resolves as platformSuperAdmin.
PLATFORM_SUPERADMIN_EMAILS=""

# Note: DELIVERECT_ACCOUNT_ID and CHANNEL_LINK_ID are runtime tenant and store mappings
# configured per tenant/store in the database, NOT global environment deployment constants.
