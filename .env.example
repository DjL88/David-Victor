# LTx local/runtime environment reference
#
# Production and staging run on Firebase App Hosting. Sensitive values should be
# supplied through Secret Manager or the deployment environment, not committed.
# This file documents supported local/development variables only.

# Altie / Google AI. Server-side only.
GEMINI_API_KEY=""

# Optional application/public origin used by local tooling or callback generation
# where a route explicitly consumes it. App Hosting uses its environment-specific
# public base URL configuration.
APP_URL=""

# Optional local/preview BFF override. Leave empty for ordinary same-origin runs.
PREVIEW_BFF_URL=""

# Mapping / geocoding
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_MAP_ID=""

# Deliverect partner credentials. Server-side only.
# Tenant/environment-scoped production credentials should be referenced through
# integration profiles + Secret Manager, not copied into browser config.
DELIVERECT_CLIENT_ID=""
DELIVERECT_CLIENT_SECRET=""
DELIVERECT_ENV="staging" # staging | production

# Initial break-glass bootstrap allowlist. Normal Admin authorization is based on
# verified membership/claims after bootstrap.
PLATFORM_SUPERADMIN_EMAILS=""

# Firebase / Firestore runtime target
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIRESTORE_DATABASE_ID=""
ALLOWED_TENANT_ENVS="staging"
INTEGRATION_PROFILE_REQUIRED="false"

# Public integration origin(s)
PUBLIC_BASE_URL=""
CHANNEL_PUBLIC_BASE_URL=""
VITE_CHANNEL_PUBLIC_BASE_URL=""

# Optional Cloud Tasks values are intentionally omitted here until queues/service
# account provisioning exists for the target environment. See
# docs/FIREBASE_PRODUCTION_BOOTSTRAP.md and the App Hosting configs.

# Secret naming convention for tenant integration profiles:
# lt--{tenant-slug}--{staging|production}--{purpose}
# Store references in integrationProfiles; never store raw secret values there.
