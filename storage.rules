rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- RETAIL COMMERCE PLATFORM & TENANT ASSETS ---
    // Storefront assets are publicly readable, but browser writes are forbidden.
    // Admin uploads use the authenticated BFF / short-lived signed GCS URLs, so
    // Firebase Storage rules do not need to grant customers or admins direct write access.
    match /tenant-assets-public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /tenant-assets-incoming/{allPaths=**} {
      allow read, write: if false;
    }
    match /tenant-assets-private/{allPaths=**} {
      allow read, write: if false;
    }
    match /tenants/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /stories/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /heroes/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /fonts/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // --- AVES RADAR: ENGINE CORE ---
    // Public read access for the species database to ensure high-speed initialization
    match /ONNX/model.onnx {
      allow read: if true;
    }
    match /images/{imageName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.lower() == 'dleitch22@gmail.com';
    }
    match /brands/{imageName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.lower() == 'dleitch22@gmail.com';
    }
    match /photos_pawtraits/{imageName} {
      allow read, write: if true;
    }
    match /portals/{allPaths=**} {
      allow read, write: if true;
    }

    // --- ROOT-LEVEL PUBLIC ASSETS (Videos & files at bucket root without folders) ---
    match /{fileName} {
      allow read: if !fileName.matches('.*/.*');
      allow write: if !fileName.matches('.*/.*') && request.auth != null && request.auth.token.email.lower() == 'dleitch22@gmail.com';
    }

    // --- AVES RADAR: USER ASSETS ---
    // Public read for sightings, restricted write to the owner
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /photos/{photoName} {
      allow read, write: if true;
    }
    match /sessions/{allPaths=**} {
      allow read, write: if true;
    }
    match /site/{photoName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.lower() == 'dleitch22@gmail.com';
    }
    match /logos/{photoName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.lower() == 'dleitch22@gmail.com';
    }
    match /videos/{photoName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.lower() == 'dleitch22@gmail.com';
    }

    // --- CLASSIFICATION & ASSETS ---
    match /labels.csv {
      allow read: if true;
    }
    match /ONNX/{allPaths=**} {
      allow read: if true;
    }
    
    // --- HI-DOMINO: SCAN DATA ---
    match /scans/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // --- HI-DOMINO: PROFILE ASSETS ---
    match /avatars/{userId}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.contentType.matches('image/.*');
    }

    // --- HI-DOMINO: GAME STATE ---
    match /games/{gameId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // --- HI-DOMINO: SCOREBOARDS ---
    match /scores/{gameId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // --- GLOBAL SAFETY NET ---
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
