rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // SEC-03: This shared Hi-Domino bucket is test-only for David-Victor.
    // David-Victor browser writes are forbidden. Admin asset publication uses
    // the authenticated BFF / short-lived signed GCS URLs and is constrained
    // server-side to tenant-assets-public/. Production must move to the
    // dedicated David-Victor bucket before launch (SEC-11).

    // --- DAVID-VICTOR TENANT ASSETS ---
    match /tenant-assets-public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /tenant-assets-incoming/{allPaths=**} {
      allow read, write: if false;
    }
    match /tenant-assets-private/{allPaths=**} {
      allow read, write: if false;
    }
    match /tenants/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /stories/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /heroes/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /fonts/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // --- LEGACY SHARED-BUCKET APPLICATION DATA ---
    // These paths belong to other applications sharing the temporary bucket.
    // David-Victor must never grant writes to them. Existing public/authenticated
    // reads are preserved until SEC-11 isolates David-Victor into its own bucket.
    match /ONNX/model.onnx {
      allow read: if true;
      allow write: if false;
    }
    match /images/{imageName} {
      allow read: if true;
      allow write: if false;
    }
    match /brands/{imageName} {
      allow read: if true;
      allow write: if false;
    }
    match /photos_pawtraits/{imageName} {
      allow read: if true;
      allow write: if false;
    }
    match /portals/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Root-level legacy assets remain readable for compatibility, never writable.
    match /{fileName} {
      allow read: if !fileName.matches('.*/.*');
      allow write: if false;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /photos/{photoName} {
      allow read: if true;
      allow write: if false;
    }
    match /sessions/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /site/{photoName} {
      allow read: if true;
      allow write: if false;
    }
    match /logos/{photoName} {
      allow read: if true;
      allow write: if false;
    }
    match /videos/{photoName} {
      allow read: if true;
      allow write: if false;
    }
    match /labels.csv {
      allow read: if true;
      allow write: if false;
    }
    match /ONNX/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /scans/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /avatars/{userId}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /games/{gameId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /scores/{gameId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- GLOBAL SAFETY NET ---
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
