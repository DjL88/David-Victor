{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "test:certification": "vitest run src/__tests__/retail_quest_certification_contract.test.ts src/__tests__/order_payload_certification.test.ts src/__tests__/operational_certification_matrix.test.ts src/__tests__/webhook_http_certification.test.ts src/__tests__/webhook_authenticator_security.test.ts src/__tests__/webhook_raw_body_guard.test.ts src/__tests__/channel_catalog_projection.test.ts src/__tests__/tenant_isolation.test.ts src/__tests__/mfa_app_check_current.test.ts",
    "audit:gate": "bun run lint && bun run test:certification && bun run build"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.1.0",
    "@google-cloud/tasks": "^7.1.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "dompurify": "^3.4.15",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^11.1.0",
    "jsdom": "^30.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/google.maps": "^3.66.3",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1",
    "supertest": "^7.2.2"
  }
}
